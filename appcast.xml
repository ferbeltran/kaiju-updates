        <item>
            <title>0.9.16</title>
            <pubDate>Sat, 31 Oct 2026 11:42:23 -0700</pubDate>
            <sparkle:channel>beta</sparkle:channel>
            <sparkle:version>20261031.1142</sparkle:version>
